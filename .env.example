# ===== Gemini API =====
# Get your key here: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ===== Groq API (used in Phase IV evaluation : synthesizer + judge) =====
# Get your key here: https://console.groq.com/keys
# Free tier : openai/gpt-oss-120b (synthesizer) and llama-3.3-70b-versatile (judge)
GROQ_API_KEY=your_groq_api_key_here

# Optional : comma-separated list of additional Groq keys (different accounts)
# for AUTOMATIC ROTATION when one key's TPD (tokens-per-day) quota is exhausted.
# Example : GROQ_API_KEYS=gsk_keyA,gsk_keyB,gsk_keyC
# When set, the rotator walks down this list, then falls back to GROQ_API_KEY.
GROQ_API_KEYS=<nouvelle_A>,<nouvelle_B>,<nouvelle_C>

# ===== HuggingFace (optional) =====
# Only needed if you hit rate limits while downloading the embedding model
HF_TOKEN=

# ===== App settings =====
LOG_LEVEL=INFO
ENV=development
ALLOWED_ORIGINS=http://localhost:5173

# ===== JWT Authentication =====
JWT_SECRET=changeme_in_production

# ===== Database =====
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
# For production: DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/ragdb

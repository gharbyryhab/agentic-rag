# ===== Gemini API =====
# Get your key here: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ===== Groq API (used in Phase IV evaluation : synthesizer + judge) =====
# Get your key here: https://console.groq.com/keys
# Free tier : openai/gpt-oss-120b (synthesizer) and llama-3.3-70b-versatile (judge)
GROQ_API_KEY=your_groq_api_key_here

# ===== HuggingFace (optional) =====
# Only needed if you hit rate limits while downloading the embedding model
HF_TOKEN=

# ===== App settings =====
LOG_LEVEL=INFO
ENV=development
